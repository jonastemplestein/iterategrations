# Copy to "$(herdr plugin config-dir iterate-bridge)/targets": one line for each iterate project to lend
# this Herdr to, as itx.<name> (default jonas.herdr):
#
#   <iterate config>  <project>  [name]
#
# An `iterate --config <config>` name from `iterate config list`. It signs in with the CLI's stored
# login (`iterate --config <config> login`, which lasts 30 days at most), or with a key of its own in
# "<config dir>/<config>.key" (mode 600; `iterate --config <config> tokens create --project <project>
# --never-expires`).
prd          iterate
templestein  templestein
